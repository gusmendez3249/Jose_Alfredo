# Copia este archivo como .env y llena tus propios valores (el .env real NO se sube a Git)
# Neon — conexión directa estable
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require
DIRECT_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require

JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=7d
PORT=3001
NODE_ENV=development
